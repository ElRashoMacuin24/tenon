{
  "name": "M4 demo: drawing of a plate and its assembly",
  "description": "A 120 x 80 plate, t thick (a user parameter), with four 8 mm holes and a counterbored centre hole, and an assembly of it with two pins. Sheet 1 shows the plate: front, top and right views, an isometric view, a section through the centre hole and a detail of it, dimensions picked from the views, centrelines and a hole table. Sheet 2 shows the assembly with a parts list and balloons. The script checks the views, the dimension values and the table rows, exports PDF, SVG and DXF, then makes the plate thicker and checks that the drawing follows.",
  "steps": [
    { "note": "The plate: 120 x 80, t = 12.",
      "run": "file.new", "with": { "name": "Plate" } },
    { "run": "param.add", "with": { "name": "t", "equation": "12 mm", "comment": "plate thickness" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "plate_sk" },
    { "run": "sketch.rectangle", "with": { "sketch": "$plate_sk.feature", "x1": 0, "y1": 0, "x2": 120, "y2": 80 }, "as": "box" },
    { "run": "model.extrude", "with": { "sketch": "$plate_sk.feature", "distance": 12, "equations": { "/extent/distance": "t" } }, "as": "plate_x" },
    { "note": "Four 8 mm holes through, 15 in from each corner, sketched on the top face.",
      "run": "model.face_ref", "with": { "origin": { "type": "cap", "feature": "$plate_x.feature", "end": "end" } }, "as": "top" },
    { "run": "sketch.create", "with": { "face": "$top" }, "as": "corner_sk" },
    { "run": "sketch.point", "with": { "sketch": "$corner_sk.feature", "x": 15, "y": 15 } },
    { "run": "sketch.point", "with": { "sketch": "$corner_sk.feature", "x": 105, "y": 15 } },
    { "run": "sketch.point", "with": { "sketch": "$corner_sk.feature", "x": 105, "y": 65 } },
    { "run": "sketch.point", "with": { "sketch": "$corner_sk.feature", "x": 15, "y": 65 } },
    { "run": "model.hole", "with": { "sketch": "$corner_sk.feature", "diameter": 8, "through_all": true }, "as": "corners" },
    { "note": "A 10 mm hole through the middle, counterbored 18 across and 5 deep.",
      "run": "sketch.create", "with": { "face": "$top" }, "as": "bore_sk" },
    { "run": "sketch.point", "with": { "sketch": "$bore_sk.feature", "x": 60, "y": 40 } },
    { "run": "model.hole", "with": { "sketch": "$bore_sk.feature", "diameter": 10, "through_all": true, "type": "counterbore", "counterbore_diameter": 18, "counterbore_depth": 5 }, "as": "bore" },
    { "note": "115200 - 1348 pi",
      "run": "model.mass", "expect": { "bodies.0.volume": 110965.133102961 } },
    { "run": "file.save", "with": { "path": "plate.tenon" } },

    { "note": "A pin: a 14 x 4 head on an 8 x 16 shaft, the head's underside on XY.",
      "run": "file.new", "with": { "name": "Pin" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "head_sk" },
    { "run": "sketch.circle", "with": { "sketch": "$head_sk.feature", "cx": 0, "cy": 0, "r": 7 } },
    { "run": "model.extrude", "with": { "sketch": "$head_sk.feature", "distance": 4 } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "shaft_sk" },
    { "run": "sketch.circle", "with": { "sketch": "$shaft_sk.feature", "cx": 0, "cy": 0, "r": 4 } },
    { "run": "model.extrude", "with": { "sketch": "$shaft_sk.feature", "distance": 16, "reverse": true } },
    { "run": "file.save", "with": { "path": "pin.tenon" } },

    { "note": "The assembly: the plate, and a pin in two of its holes.",
      "run": "asm.new", "with": { "name": "Plate assembly" } },
    { "run": "asm.insert", "with": { "path": "plate.tenon" }, "as": "plate" },
    { "run": "asm.insert", "with": { "path": "pin.tenon" }, "as": "pin1" },
    { "run": "asm.place", "with": { "component": "$pin1.component", "origin": [15, 15, 12] } },
    { "run": "asm.insert", "with": { "path": "pin.tenon" }, "as": "pin2" },
    { "run": "asm.place", "with": { "component": "$pin2.component", "origin": [105, 65, 12] } },
    { "run": "asm.save", "with": { "path": "plate-pins.tenonasm" } },

    { "note": "The drawing: ANSI, third-angle, a B sheet (17 x 11 in).",
      "run": "drw.new", "with": { "name": "Plate", "standard": "ansi", "size": "B" }, "expect": { "size": "B" } },
    { "run": "drw.props", "with": { "title": "MOUNTING PLATE", "number": "TN-0004", "revision": "A", "drawn_by": "TENON", "date": "2026-10-08" } },
    { "note": "Front view at 1:1, then top and right views projected from it, and an isometric view at 1:2.",
      "run": "drw.view.base", "with": { "model": "plate.tenon", "orientation": "front", "scale": 1, "at": [100, 70] }, "as": "front", "expect": { "name": "VIEW1", "scale": 1 } },
    { "run": "drw.view.projected", "with": { "parent": "$front.view", "side": "above" }, "as": "top_v" },
    { "run": "drw.view.projected", "with": { "parent": "$front.view", "side": "right" }, "as": "right_v" },
    { "run": "drw.view.projected", "with": { "parent": "$front.view", "side": "above_right", "scale": 0.5, "at": [345, 175] }, "as": "iso_v" },
    { "run": "drw.info", "expect": {
        "views.0.direction.1": -1, "views.0.size.0": 120, "views.0.size.1": 12,
        "views.1.direction.2": 1, "views.1.size.0": 120, "views.1.size.1": 80,
        "views.2.direction.0": 1, "views.2.size.0": 80, "views.2.size.1": 12,
        "views.3.hidden_curves": 0 } },

    { "note": "Section A-A along the middle of the top view, seen from the front; detail B of the counterbore in the front view, at 2:1.",
      "run": "drw.view.section", "with": { "parent": "$top_v.view", "a": [-6, 40], "b": [126, 40], "flip": true, "at": [100, 235] }, "as": "sec", "expect": { "name": "A" } },
    { "run": "drw.view.detail", "with": { "parent": "$front.view", "center": [60, 9], "radius": 10, "at": [240, 165] }, "as": "det", "expect": { "name": "B" } },
    { "run": "drw.info", "expect": { "views.4.direction.1": -1, "views.4.size.0": 120, "views.4.size.1": 12, "views.5.scale": 2 } },

    { "note": "Dimensions picked from the drawn edges: the top view's width and depth, the counterbore's diameter, the front view's thickness.",
      "run": "drw.pick", "with": { "view": "$top_v.view", "view_at": [60, 80] }, "as": "back_edge", "expect": { "kind": "line", "length": 120 } },
    { "run": "drw.dimension", "with": { "view": "$top_v.view", "type": "horizontal", "a": "$back_edge", "by": [0, 12] }, "as": "d_width", "expect": { "value": 120, "shown": "120" } },
    { "run": "drw.pick", "with": { "view": "$top_v.view", "view_at": [120, 40] }, "as": "right_edge", "expect": { "kind": "line", "length": 80 } },
    { "run": "drw.dimension", "with": { "view": "$top_v.view", "type": "vertical", "a": "$right_edge", "by": [22, 0] }, "as": "d_depth", "expect": { "value": 80 } },
    { "run": "drw.pick", "with": { "view": "$top_v.view", "view_at": [69, 40] }, "as": "cbore", "expect": { "kind": "circle", "diameter": 18 } },
    { "run": "drw.dimension", "with": { "view": "$top_v.view", "type": "diameter", "a": "$cbore", "by": [-14, 30] }, "as": "d_cbore", "expect": { "value": 18, "shown": "Ø18" } },
    { "run": "drw.pick", "with": { "view": "$front.view", "view_at": [0, 6] }, "as": "left_edge", "expect": { "kind": "line", "length": 12 } },
    { "run": "drw.dimension", "with": { "view": "$front.view", "type": "vertical", "a": "$left_edge", "by": [-12, 0] }, "as": "d_thick", "expect": { "value": 12 } },
    { "note": "Hole positions from the top view's bottom-left corner.",
      "run": "drw.hole_table", "with": { "view": "$top_v.view", "at": [281, 262] }, "as": "holes", "expect": {
        "rows.0.tag": "A1", "rows.0.x": 15, "rows.0.y": 15, "rows.0.description": "Ø8 THRU",
        "rows.2.tag": "A3", "rows.2.x": 105, "rows.2.y": 65,
        "rows.4.tag": "B1", "rows.4.x": 60, "rows.4.y": 40, "rows.4.description": "Ø10 THRU, CBORE Ø18 DEEP 5" } },
    { "run": "drw.note", "with": { "text": "NOTES: BREAK ALL SHARP EDGES. DIMENSIONS IN MM.", "at": [20, 24], "height": 3 } },

    { "run": "drw.save", "with": { "path": "plate.tenondrw" } },
    { "run": "drw.export.pdf", "with": { "path": "plate.pdf" }, "expect": { "pages": 1 } },
    { "run": "drw.export.svg", "with": { "path": "plate.svg" } },
    { "run": "drw.export.dxf", "with": { "path": "plate.dxf" } },
    { "run": "render.png", "with": { "path": "plate-sheet1.png", "width": 1700 } },

    { "note": "Associativity: the plate made 16 thick. Its file is saved, the drawing updated: the views and the thickness dimension follow.",
      "run": "file.open", "with": { "path": "plate.tenon" } },
    { "run": "param.set", "with": { "name": "t", "equation": "16" } },
    { "note": "153600 - 1704 pi",
      "run": "model.mass", "expect": { "bodies.0.volume": 148246.726118283 } },
    { "run": "file.save", "with": { "path": "plate.tenon" } },
    { "run": "drw.update", "expect": { "models.0": "plate.tenon" } },
    { "run": "drw.info", "expect": {
        "views.0.size.1": 16, "views.4.size.1": 16,
        "annotations.0.value": 120, "annotations.1.value": 80, "annotations.2.value": 18, "annotations.3.value": 16, "annotations.3.shown": "16",
        "annotations.4.rows.4.description": "Ø10 THRU, CBORE Ø18 DEEP 5" } },

    { "note": "Sheet 2: the assembly, isometric, with a parts list and a balloon for each part. The pins sit on the thicker plate.",
      "run": "asm.open", "with": { "path": "plate-pins.tenonasm" } },
    { "run": "asm.place", "with": { "component": "$pin1.component", "origin": [15, 15, 16] } },
    { "run": "asm.place", "with": { "component": "$pin2.component", "origin": [105, 65, 16] } },
    { "run": "asm.save", "with": { "path": "plate-pins.tenonasm" } },
    { "run": "drw.sheet.add", "with": { "size": "B" }, "as": "sheet2", "expect": { "sheet": 2 } },
    { "run": "drw.view.base", "with": { "model": "plate-pins.tenonasm", "orientation": "iso", "sheet": "$sheet2.sheet", "at": [150, 160] }, "as": "asm_v" },
    { "run": "drw.parts_list", "with": { "view": "$asm_v.view" }, "expect": {
        "rows.0.item": 1, "rows.0.quantity": 1, "rows.0.part_number": "plate", "rows.0.description": "Plate",
        "rows.1.item": 2, "rows.1.quantity": 2, "rows.1.part_number": "pin", "rows.1.description": "Pin" } },
    { "run": "drw.balloon.auto", "with": { "view": "$asm_v.view" }, "expect": { "added": 2 } },
    { "run": "drw.info", "expect": { "sheets.1.size": "B", "views.6.sheet": 2, "annotations.7.item": 1, "annotations.8.item": 2 } },

    { "run": "drw.save", "with": { "path": "plate.tenondrw" } },
    { "run": "drw.export.pdf", "with": { "path": "plate.pdf" }, "expect": { "pages": 2 } },
    { "run": "render.png", "with": { "path": "plate-sheet1.png", "width": 1700 } },
    { "run": "render.png", "with": { "path": "plate-sheet2.png", "width": 1700, "sheet": 2 } },

    { "note": "Reopened: the views are made again from the model files.",
      "run": "drw.open", "with": { "path": "plate.tenondrw" }, "expect": { "views": 7, "missing": [] } },
    { "run": "drw.info", "expect": { "annotations.3.value": 16, "annotations.8.item": 2, "views.6.error": null } }
  ]
}
