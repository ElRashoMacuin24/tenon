{
  "name": "M3 demo: pivot assembly",
  "description": "Four part files (a base plate, an arm, a pin used twice, a sliding block) placed in an assembly with a rotational joint, an angle, two inserts and a slider joint. The script checks positions, degrees of freedom, the parts list, the total volume and interference, makes an exploded view, edits the arm in place and reopens the saved assembly.",
  "steps": [
    { "note": "Base: an 80 x 40 x 10 plate with two 8 mm holes.",
      "run": "file.new", "with": { "name": "Base" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "base_sk" },
    { "run": "sketch.rectangle", "with": { "sketch": "$base_sk.feature", "x1": 0, "y1": 0, "x2": 80, "y2": 40 }, "as": "base_box" },
    { "run": "sketch.circle", "with": { "sketch": "$base_sk.feature", "cx": 20, "cy": 20, "r": 4 }, "as": "base_h1" },
    { "run": "sketch.circle", "with": { "sketch": "$base_sk.feature", "cx": 60, "cy": 20, "r": 4 }, "as": "base_h2" },
    { "run": "model.extrude", "with": { "sketch": "$base_sk.feature", "distance": 10 }, "as": "base_x" },
    { "note": "32000 - 320 pi",
      "run": "model.mass", "expect": { "bodies.0.volume": 30994.690350851266 } },
    { "run": "file.save", "with": { "path": "base.tenon" } },

    { "note": "Arm: 60 x 16, t thick (a user parameter), with an 8 mm hole at each end.",
      "run": "file.new", "with": { "name": "Arm" } },
    { "run": "param.add", "with": { "name": "t", "equation": "5 mm", "comment": "arm thickness" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "arm_sk" },
    { "run": "sketch.rectangle", "with": { "sketch": "$arm_sk.feature", "x1": 0, "y1": 0, "x2": 60, "y2": 16 }, "as": "arm_box" },
    { "run": "sketch.circle", "with": { "sketch": "$arm_sk.feature", "cx": 8, "cy": 8, "r": 4 }, "as": "arm_h1" },
    { "run": "sketch.circle", "with": { "sketch": "$arm_sk.feature", "cx": 52, "cy": 8, "r": 4 } },
    { "run": "model.extrude", "with": { "sketch": "$arm_sk.feature", "distance": 5, "equations": { "/extent/distance": "t" } }, "as": "arm_x" },
    { "note": "(960 - 32 pi) t",
      "run": "model.mass", "expect": { "bodies.0.volume": 4297.345175425633 } },
    { "run": "file.save", "with": { "path": "arm.tenon" } },

    { "note": "Pin: a 12 x 3 head on an 8 x 22 shaft, the head's underside on XY.",
      "run": "file.new", "with": { "name": "Pin" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "head_sk" },
    { "run": "sketch.circle", "with": { "sketch": "$head_sk.feature", "cx": 0, "cy": 0, "r": 6 } },
    { "run": "model.extrude", "with": { "sketch": "$head_sk.feature", "distance": 3 }, "as": "head_x" },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "shaft_sk" },
    { "run": "sketch.circle", "with": { "sketch": "$shaft_sk.feature", "cx": 0, "cy": 0, "r": 4 }, "as": "shaft_c" },
    { "run": "model.extrude", "with": { "sketch": "$shaft_sk.feature", "distance": 22, "reverse": true }, "as": "shaft_x" },
    { "note": "108 pi + 352 pi",
      "run": "model.mass", "expect": { "bodies.0.volume": 1445.1326206513048 } },
    { "run": "file.save", "with": { "path": "pin.tenon" } },

    { "note": "Block: 20 x 40 x 10.",
      "run": "file.new", "with": { "name": "Block" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "block_sk" },
    { "run": "sketch.rectangle", "with": { "sketch": "$block_sk.feature", "x1": 0, "y1": 0, "x2": 20, "y2": 40 }, "as": "block_box" },
    { "run": "model.extrude", "with": { "sketch": "$block_sk.feature", "distance": 10 }, "as": "block_x" },
    { "run": "file.save", "with": { "path": "block.tenon" } },

    { "note": "The assembly. The first component placed is grounded at the origin.",
      "run": "asm.new", "with": { "name": "Pivot" } },
    { "run": "asm.insert", "with": { "path": "base.tenon" }, "as": "base", "expect": { "name": "base:1", "grounded": true } },
    { "run": "asm.insert", "with": { "path": "arm.tenon" }, "as": "arm", "expect": { "name": "arm:1", "grounded": false } },

    { "note": "Rotational joint: the arm's first hole (underside) on the base's first hole (top). The arm can turn about it.",
      "run": "asm.geom", "with": { "component": "$base.component", "edge": [{ "type": "cap", "feature": "$base_x.feature", "end": "end" }, { "type": "side", "feature": "$base_x.feature", "curve": "$base_h1.circle" }] }, "as": "base_hole1", "expect": { "kind": "circle" } },
    { "run": "asm.geom", "with": { "component": "$arm.component", "edge": [{ "type": "cap", "feature": "$arm_x.feature", "end": "start" }, { "type": "side", "feature": "$arm_x.feature", "curve": "$arm_h1.circle" }] }, "as": "arm_hole1_under" },
    { "run": "asm.joint", "with": { "type": "revolute", "a": "$base_hole1", "b": "$arm_hole1_under" }, "expect": { "name": "Rotational:1", "dof": 1 } },
    { "run": "asm.dof", "expect": { "components.1.dof": 1, "components.1.rotations.0.point.0": 20, "components.1.rotations.0.point.1": 20 } },

    { "note": "Angle: the arm's front face at 90 degrees to the base's front face, so the arm points along +Y.",
      "run": "asm.geom", "with": { "component": "$base.component", "face": { "type": "side", "feature": "$base_x.feature", "curve": "$base_box.lines.0" } }, "as": "base_front" },
    { "run": "asm.geom", "with": { "component": "$arm.component", "face": { "type": "side", "feature": "$arm_x.feature", "curve": "$arm_box.lines.0" } }, "as": "arm_front" },
    { "run": "asm.constrain", "with": { "type": "angle", "a": "$base_front", "b": "$arm_front", "angle": 1.5707963267948966 }, "expect": { "name": "Angle:1", "dof": 0 } },
    { "run": "asm.tree", "expect": { "components.1.placement.origin.0": 28, "components.1.placement.origin.1": 12, "components.1.placement.origin.2": 10, "components.1.placement.x.1": 1, "components.1.dof": 0 } },

    { "note": "A pin through the arm into the base: insert its head's inner edge on the arm's hole (top). It can still turn.",
      "run": "asm.insert", "with": { "path": "pin.tenon" }, "as": "pin1", "expect": { "name": "pin:1" } },
    { "run": "asm.geom", "with": { "component": "$arm.component", "edge": [{ "type": "cap", "feature": "$arm_x.feature", "end": "end" }, { "type": "side", "feature": "$arm_x.feature", "curve": "$arm_h1.circle" }] }, "as": "arm_hole1_top" },
    { "run": "asm.geom", "with": { "component": "$pin1.component", "edge": [{ "type": "cap", "feature": "$head_x.feature", "end": "start" }, { "type": "side", "feature": "$shaft_x.feature", "curve": "$shaft_c.circle" }] }, "as": "pin1_edge" },
    { "run": "asm.constrain", "with": { "type": "insert", "a": "$arm_hole1_top", "b": "$pin1_edge" }, "expect": { "name": "Insert:1", "dof": 1 } },
    { "run": "asm.tree", "expect": { "components.2.placement.origin.0": 20, "components.2.placement.origin.1": 20, "components.2.placement.origin.2": 15, "components.2.dof": 1 } },

    { "note": "The same part again, in the base's second hole.",
      "run": "asm.insert", "with": { "path": "pin.tenon" }, "as": "pin2", "expect": { "name": "pin:2" } },
    { "run": "asm.geom", "with": { "component": "$base.component", "edge": [{ "type": "cap", "feature": "$base_x.feature", "end": "end" }, { "type": "side", "feature": "$base_x.feature", "curve": "$base_h2.circle" }] }, "as": "base_hole2" },
    { "run": "asm.geom", "with": { "component": "$pin2.component", "edge": [{ "type": "cap", "feature": "$head_x.feature", "end": "start" }, { "type": "side", "feature": "$shaft_x.feature", "curve": "$shaft_c.circle" }] }, "as": "pin2_edge" },
    { "run": "asm.constrain", "with": { "type": "insert", "a": "$base_hole2", "b": "$pin2_edge" }, "expect": { "dof": 2 } },

    { "note": "Slider joint: the block's bottom front edge runs along the base's top front edge.",
      "run": "asm.insert", "with": { "path": "block.tenon" }, "as": "block" },
    { "run": "asm.geom", "with": { "component": "$base.component", "edge": [{ "type": "cap", "feature": "$base_x.feature", "end": "end" }, { "type": "side", "feature": "$base_x.feature", "curve": "$base_box.lines.0" }] }, "as": "base_rail", "expect": { "kind": "axis" } },
    { "run": "asm.geom", "with": { "component": "$block.component", "edge": [{ "type": "cap", "feature": "$block_x.feature", "end": "start" }, { "type": "side", "feature": "$block_x.feature", "curve": "$block_box.lines.0" }] }, "as": "block_rail" },
    { "run": "asm.joint", "with": { "type": "slider", "a": "$base_rail", "b": "$block_rail", "flip": true }, "expect": { "name": "Slider:1", "dof": 3 } },
    { "run": "asm.place", "with": { "component": "$block.component", "origin": [50, 0, 10] }, "expect": { "placement.origin.0": 50, "placement.origin.1": 0, "placement.origin.2": 10, "placement.z.2": 1, "placement.x.0": 1 } },
    { "run": "asm.dof", "expect": { "dof": 3, "components.0.dof": 0, "components.1.dof": 0, "components.2.dof": 1, "components.3.dof": 1, "components.4.dof": 1, "components.4.translations.0.0": 1 } },

    { "note": "The block covers the second pin's head: 108 pi of overlap.",
      "run": "asm.interference", "expect": { "count": 1, "volume": 339.29200658769764, "clashes.0.a": "pin:2", "clashes.0.b": "block:1" } },
    { "note": "Dragging the block 20 left (and up and back, which the slider ignores) clears it.",
      "run": "asm.move", "with": { "component": "$block.component", "by": [-20, 7, 3] }, "expect": { "placement.origin.0": 30, "placement.origin.1": 0, "placement.origin.2": 10 } },
    { "run": "asm.interference", "expect": { "count": 0 } },

    { "run": "asm.bom", "expect": { "parts": 4, "components": 5, "rows.0.name": "Base", "rows.1.name": "Arm", "rows.2.name": "Pin", "rows.2.quantity": 2, "rows.3.name": "Block" } },
    { "note": "44800 + 440 pi",
      "run": "asm.mass", "expect": { "volume": 46182.30076757951 } },
    { "run": "render.png", "with": { "path": "pivot.png", "view": "iso", "width": 1024, "height": 768 } },

    { "note": "Exploded view from the relationships: each part moves 30 away from what holds it, carrying what it holds.",
      "run": "asm.explode.auto", "with": { "spacing": 30 }, "expect": { "steps": 4 } },
    { "run": "asm.explode.positions", "expect": { "components.1.origin.2": 40, "components.2.origin.2": 75, "components.3.origin.2": 40 } },
    { "run": "render.png", "with": { "path": "pivot-exploded.png", "view": "iso", "width": 1024, "height": 768, "exploded": true } },

    { "note": "Edit the arm in place: t = 8. The pin on it rises with its top face.",
      "run": "asm.edit_part", "with": { "component": "$arm.component", "run": "param.set", "with": { "name": "t", "equation": "8" } }, "expect": { "converged": true } },
    { "run": "asm.tree", "expect": { "components.2.placement.origin.2": 18, "dof": 3 } },
    { "note": "47680 + 344 pi",
      "run": "asm.mass", "expect": { "volume": 48760.68787283489 } },

    { "run": "asm.save", "with": { "path": "pivot.tenonasm" } },
    { "run": "asm.export_step", "with": { "path": "pivot.step" } },
    { "run": "asm.export_bom", "with": { "path": "pivot-bom.csv" }, "expect": { "rows": 4 } },

    { "note": "Reopened: the parts are read from their files, the arm with t = 8.",
      "run": "asm.open", "with": { "path": "pivot.tenonasm" }, "expect": { "components": 5 } },
    { "run": "asm.mass", "expect": { "volume": 48760.68787283489 } },
    { "run": "asm.dof", "expect": { "dof": 3 } }
  ]
}
