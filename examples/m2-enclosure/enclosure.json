{
  "name": "M2 demo: parametric enclosure",
  "description": "A filleted, shelled box with four screw bosses and a cable hole, every size driven by the user parameters L, W, H and t. The bosses and their holes are one rectangular pattern whose spacing follows L and W. The script checks the analytic volume at each stage, then changes L and H and checks the whole enclosure again.",
  "steps": [
    { "run": "document.rename", "with": { "name": "Enclosure" } },
    { "run": "param.add", "with": { "name": "L", "equation": "80 mm", "comment": "outside length" } },
    { "run": "param.add", "with": { "name": "W", "equation": "60 mm", "comment": "outside width" } },
    { "run": "param.add", "with": { "name": "H", "equation": "30 mm", "comment": "outside height" } },
    { "run": "param.add", "with": { "name": "t", "equation": "2 mm", "comment": "wall thickness" } },

    { "note": "The footprint: an L x W rectangle with a corner on the origin.",
      "run": "sketch.create", "with": { "plane": "xy" }, "as": "base" },
    { "run": "sketch.rectangle", "with": { "sketch": "$base.feature", "x1": 0, "y1": 0, "x2": 80, "y2": 60 }, "as": "box" },
    { "run": "sketch.constrain", "with": { "sketch": "$base.feature", "constraint": { "type": "coincident", "a": "$box.corners.0", "b": "$base.origin" } } },
    { "run": "sketch.constrain", "with": { "sketch": "$base.feature", "constraint": { "type": "length", "line": "$box.lines.0", "value": 80 }, "equation": "L" } },
    { "run": "sketch.constrain", "with": { "sketch": "$base.feature", "constraint": { "type": "length", "line": "$box.lines.1", "value": 60 }, "equation": "W" } },
    { "run": "sketch.info", "with": { "sketch": "$base.feature" }, "expect": { "dof": 0 } },
    { "run": "model.extrude", "with": { "sketch": "$base.feature", "distance": 30, "equations": { "/extent/distance": "H" } }, "as": "body" },
    { "run": "model.mass", "expect": { "bodies.0.volume": 144000 } },

    { "note": "Round the four vertical edges (r 6), each named by the two sides it joins.",
      "run": "model.edge_ref", "with": { "faces": [{ "type": "side", "feature": "$body.feature", "curve": "$box.lines.0" }, { "type": "side", "feature": "$body.feature", "curve": "$box.lines.1" }] }, "as": "e1" },
    { "run": "model.edge_ref", "with": { "faces": [{ "type": "side", "feature": "$body.feature", "curve": "$box.lines.1" }, { "type": "side", "feature": "$body.feature", "curve": "$box.lines.2" }] }, "as": "e2" },
    { "run": "model.edge_ref", "with": { "faces": [{ "type": "side", "feature": "$body.feature", "curve": "$box.lines.2" }, { "type": "side", "feature": "$body.feature", "curve": "$box.lines.3" }] }, "as": "e3" },
    { "run": "model.edge_ref", "with": { "faces": [{ "type": "side", "feature": "$body.feature", "curve": "$box.lines.3" }, { "type": "side", "feature": "$body.feature", "curve": "$box.lines.0" }] }, "as": "e4" },
    { "run": "model.fillet", "with": { "edges": ["$e1", "$e2", "$e3", "$e4"], "radius": 6 } },
    { "note": "(L W - (4 - pi) 36) H",
      "run": "model.mass", "expect": { "bodies.0.volume": 143072.920066 } },

    { "note": "Shell it t thick, open at the top.",
      "run": "model.face_ref", "with": { "origin": { "type": "cap", "feature": "$body.feature", "end": "end" } }, "as": "top" },
    { "run": "model.shell", "with": { "remove": ["$top"], "thickness": 2, "equations": { "/thickness": "t" } } },
    { "note": "minus the cavity ((L - 2t)(W - 2t) - (4 - pi)(6 - t)^2)(H - t)",
      "run": "model.mass", "expect": { "bodies.0.volume": 24289.486557 } },

    { "note": "A screw boss on the floor (work plane t above XY) up to 5 below the rim, with a 2.5 mm hole 10 deep from a work plane at H - 5.",
      "run": "work.plane", "with": { "base": "xy", "distance": 2, "equations": { "/distance": "t" } }, "as": "floor" },
    { "run": "sketch.create", "with": { "work_plane": "$floor.feature" }, "as": "boss_sketch" },
    { "run": "sketch.circle", "with": { "sketch": "$boss_sketch.feature", "cx": 12, "cy": 12, "r": 4 } },
    { "run": "model.extrude", "with": { "sketch": "$boss_sketch.feature", "distance": 23, "equations": { "/extent/distance": "H - 5 - t" } }, "as": "boss" },
    { "run": "work.plane", "with": { "base": "xy", "distance": 25, "equations": { "/distance": "H - 5" } }, "as": "boss_top" },
    { "run": "sketch.create", "with": { "work_plane": "$boss_top.feature" }, "as": "screw_sketch" },
    { "run": "sketch.point", "with": { "sketch": "$screw_sketch.feature", "x": 12, "y": 12 } },
    { "run": "model.hole", "with": { "sketch": "$screw_sketch.feature", "diameter": 2.5, "depth": 10, "flat_bottom": true }, "as": "screw" },
    { "note": "Boss and hole into all four corners: spacing L - 24 by W - 24.",
      "run": "model.pattern.rect", "with": { "features": ["$boss.feature", "$screw.feature"], "direction": "x", "count": 2, "spacing": 56, "direction2": "y", "count2": 2, "spacing2": 36, "equations": { "/spacing1": "L - 24", "/spacing2": "W - 24" } } },
    { "note": "+ 4 pi 4^2 (H - 5 - t) - 4 pi 1.25^2 10",
      "run": "model.mass", "expect": { "bodies.0.volume": 28717.561402 } },

    { "note": "An 8 mm cable hole through the front wall, at the middle of the front face (L / 2, H / 2), t deep.",
      "run": "sketch.create", "with": { "plane": "xz" }, "as": "cable_sketch" },
    { "run": "sketch.point", "with": { "sketch": "$cable_sketch.feature", "x": 40, "y": 15 }, "as": "cable_point" },
    { "run": "sketch.constrain", "with": { "sketch": "$cable_sketch.feature", "constraint": { "type": "horizontal_distance", "a": "$cable_sketch.origin", "b": "$cable_point.point", "value": 40 }, "equation": "L / 2" } },
    { "run": "sketch.constrain", "with": { "sketch": "$cable_sketch.feature", "constraint": { "type": "vertical_distance", "a": "$cable_sketch.origin", "b": "$cable_point.point", "value": 15 }, "equation": "H / 2" } },
    { "run": "model.hole", "with": { "sketch": "$cable_sketch.feature", "diameter": 8, "depth": 2, "flat_bottom": true, "equations": { "/extent/distance": "t" } } },
    { "note": "- pi 4^2 t",
      "run": "model.mass", "expect": { "bodies.0.volume": 28617.030437 } },
    { "run": "model.topology", "expect": { "bodies.0.valid": true, "bodies.0.solids": 1 } },
    { "run": "render.png", "with": { "path": "enclosure.png", "view": "iso", "width": 1024, "height": 768 } },

    { "note": "Parametric edit: L = 100, H = 40. The box, its fillets and shell, the boss pattern spacing, the boss heights and the cable hole position all follow.",
      "run": "param.set", "with": { "name": "L", "equation": "100" } },
    { "run": "param.set", "with": { "name": "H", "equation": "40" } },
    { "run": "model.regenerate", "expect": { "bodies": 1, "error": null } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 41335.968266 } },
    { "run": "model.topology", "expect": { "bodies.0.valid": true, "bodies.0.solids": 1 } },
    { "run": "render.png", "with": { "path": "enclosure-larger.png", "view": "iso", "width": 1024, "height": 768 } },
    { "run": "edit.undo" },
    { "run": "edit.undo" },
    { "run": "model.mass", "expect": { "bodies.0.volume": 28617.030437 } },

    { "run": "file.save", "with": { "path": "enclosure.tenon" } },
    { "run": "export.step", "with": { "path": "enclosure.step" } },
    { "run": "export.stl", "with": { "path": "enclosure.stl" } }
  ]
}
