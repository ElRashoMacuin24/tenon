  { id = 2, type = "point", pos = { x = 0.0, y = 0.0 }, construction = false },
  { id = 3, type = "point", pos = { x = 60.0, y = 0.0 }, construction = false },
  { id = 4, type = "line", start = 2, end = 3, construction = false },
  { id = 5, type = "point", pos = { x = 60.0, y = 8.0 }, construction = false },
  { id = 6, type = "line", start = 3, end = 5, construction = false },
  { id = 7, type = "point", pos = { x = 8.0, y = 8.0 }, construction = false },
  { id = 8, type = "line", start = 5, end = 7, construction = false },
  { id = 9, type = "point", pos = { x = 8.0, y = 38.0 }, construction = false },
  { id = 10, type = "line", start = 7, end = 9, construction = false },
  { id = 11, type = "point", pos = { x = 0.0, y = 38.0 }, construction = false },
  { id = 12, type = "line", start = 9, end = 11, construction = false },
  { id = 13, type = "line", start = 11, end = 2, construction = false },
]
constraints = [
  { id = 1, type = "fix", point = 1 },
  { id = 2, type = "fix", point = 2 },
  { id = 3, type = "horizontal", line = 4 },
  { id = 4, type = "horizontal", line = 8 },
  { id = 5, type = "horizontal", line = 12 },
  { id = 6, type = "vertical", line = 6 },
  { id = 7, type = "vertical", line = 10 },
  { id = 8, type = "vertical", line = 13 },
  { id = 9, type = "length", line = 4, value = 60.0 },
  { id = 10, type = "length", line = 6, value = 8.0 },
  { id = 11, type = "length", line = 10, value = 30.0 },
  { id = 12, type = "length", line = 12, value = 8.0 },
]

[[feature]]
