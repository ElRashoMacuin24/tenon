plane = { face = { origin = { type = "side", feature = 2, curve = 8 }, fingerprint = { surface = "plane", direction = { x = 0.0, y = 0.0, z = 1.0 }, centroid = { x = 34.0, y = 20.0, z = 8.0 }, area = 2080.0 } } }
