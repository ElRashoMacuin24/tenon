  { id = 9, type = "point", pos = { x = 3.75, y = -6.495190528 }, construction = false },
  { id = 10, type = "line", start = 4, end = 5, construction = false },
  { id = 11, type = "line", start = 5, end = 6, construction = false },
  { id = 12, type = "line", start = 6, end = 7, construction = false },
  { id = 13, type = "line", start = 7, end = 8, construction = false },
  { id = 14, type = "line", start = 8, end = 9, construction = false },
  { id = 15, type = "line", start = 9, end = 4, construction = false },
]
