# Tenon part file, format version 2. The format: docs/file-format.md in the Tenon sources.
format = "tenon"
version = 2
name = "Bolt"
next_feature = 5

[material]
name = "Steel, mild"
density = 7.85
color = "#8a9199"

[table]
active = "M8x30"
columns = ["d1"]
rows = [
  { name = "M8x30", values = [30.0] },
  { name = "M8x50", values = [50.0] },
]

[parameters]
next = 3
user = []
model = [
  { name = "d0", target = { kind = "feature", feature = 2, field = "/extent/distance" } },
  { name = "d1", target = { kind = "feature", feature = 4, field = "/extent/distance" } },
  { name = "d2", target = { kind = "feature", feature = 5, field = "/length/distance" } },
]

