  { id = 3, type = "point_on_curve", point = 5, curve = 3 },
  { id = 4, type = "point_on_curve", point = 6, curve = 3 },
  { id = 5, type = "point_on_curve", point = 7, curve = 3 },
  { id = 6, type = "point_on_curve", point = 8, curve = 3 },
  { id = 7, type = "point_on_curve", point = 9, curve = 3 },
  { id = 8, type = "equal", a = 10, b = 11 },
  { id = 9, type = "equal", a = 11, b = 12 },
  { id = 10, type = "equal", a = 12, b = 13 },
  { id = 11, type = "equal", a = 13, b = 14 },
  { id = 12, type = "equal", a = 14, b = 15 },
]

[[feature]]
