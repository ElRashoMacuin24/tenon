# Tenon part file, format version 2. The format: docs/file-format.md in the Tenon sources.
format = "tenon"
version = 2
name = "Nozzle"
next_feature = 14

[material]
name = "PLA"
density = 1.24
color = "#4f9fd8"

[parameters]
next = 6
user = []
model = [
  { name = "d0", target = { kind = "feature", feature = 2, field = "/extent/distance" } },
  { name = "d1", target = { kind = "feature", feature = 3, field = "/angle" }, equation = "5 deg" },
  { name = "d2", target = { kind = "feature", feature = 4, field = "/distance" } },
  { name = "d3", target = { kind = "feature", feature = 6, field = "/distance" } },
  { name = "d4", target = { kind = "feature", feature = 10, field = "/extent/distance" } },
  { name = "d5", target = { kind = "feature", feature = 10, field = "/taper" }, equation = "3 deg" },
]

