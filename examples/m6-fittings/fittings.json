{
  "name": "M6 demo: four fittings",
  "description": "Four parts that between them use every M6 feature: a spring (coil) in two sizes from a design table, a bolt with a thread that is first cosmetic and then cut, a handle swept along a bent path, and a nozzle made of a drafted flange, a loft, a tapered extrusion, a split and a combine. Each part has a material; one has a colour of its own. Volumes and masses are checked against their analytic values, and the four go into an assembly whose parts list names the materials and the masses.",
  "steps": [
    { "note": "Spring: 2 mm wire wound 8 mm from the Z axis, 6 turns at a pitch of 5.",
      "run": "file.new", "with": { "name": "Spring" } },
    { "run": "sketch.create", "with": { "plane": "xz" }, "as": "wire" },
    { "run": "sketch.circle", "with": { "sketch": "$wire.feature", "cx": 8, "cy": 0, "r": 1 } },
    { "run": "model.coil", "with": { "sketch": "$wire.feature", "axis": "z", "pitch": 5, "turns": 6 }, "as": "coil" },
    { "note": "Each turn is the wire's area times the way its centre goes round: pi x 16 pi. The kernel approximates the surface, so this is checked to 1e-4.",
      "run": "model.mass", "expect": { "bodies.0.volume": 947.4820225 }, "within": 0.0001 },
    { "note": "Stainless steel, 8 g/cm^3.",
      "run": "document.material", "with": { "name": "Stainless steel" }, "expect": { "material.density": 8 } },
    { "run": "model.mass", "expect": { "mass": 7.57985618, "material": "Stainless steel" }, "within": 0.0001 },
    { "note": "Two sizes in a design table: the part as it stands is the first row.",
      "run": "table.create", "with": { "columns": ["d0", "d1"], "row": "Soft" }, "expect": { "table.rows.0.values.0": 5, "table.rows.0.values.1": 6 } },
    { "run": "table.add_row", "with": { "name": "Stiff", "values": { "d0": 3, "d1": 10 } } },
    { "run": "table.activate", "with": { "row": "Stiff" } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 1579.136704 }, "within": 0.0001 },
    { "run": "render.png", "with": { "path": "spring-stiff.png", "view": "iso", "width": 1024, "height": 768 } },
    { "run": "table.activate", "with": { "row": "Soft" } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 947.4820225 }, "within": 0.0001 },
    { "run": "file.save", "with": { "path": "spring.tenon" } },
    { "run": "render.png", "with": { "path": "spring.png", "view": "iso", "width": 1024, "height": 768 } },

    { "note": "Bolt: a hexagonal head 15 across its corners and 5.3 high, on an 8 x 30 shank.",
      "run": "file.new", "with": { "name": "Bolt" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "head_sk" },
    { "run": "sketch.polygon", "with": { "sketch": "$head_sk.feature", "cx": 0, "cy": 0, "x": 7.5, "y": 0, "sides": 6 } },
    { "run": "model.extrude", "with": { "sketch": "$head_sk.feature", "distance": 5.3 }, "as": "head" },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "shank_sk" },
    { "run": "sketch.circle", "with": { "sketch": "$shank_sk.feature", "cx": 0, "cy": 0, "r": 4 }, "as": "shank_c" },
    { "run": "model.extrude", "with": { "sketch": "$shank_sk.feature", "distance": 30, "reverse": true }, "as": "shank" },
    { "note": "3 sqrt(3) / 2 x 7.5^2 x 5.3 + 480 pi",
      "run": "model.mass", "expect": { "bodies.0.volume": 2282.515944 } },
    { "note": "A cosmetic thread, 20 long from the free end: sized from the shank (ISO coarse), on record, and the solid is as it was.",
      "run": "model.face_ref", "with": { "origin": { "type": "side", "feature": "$shank.feature", "curve": "$shank_c.circle" } }, "as": "shank_face" },
    { "run": "model.thread", "with": { "face": "$shank_face", "length": 20 }, "as": "thread" },
    { "run": "model.threads", "expect": { "threads.0.designation": "M8x1.25", "threads.0.pitch": 1.25, "threads.0.diameter": 8, "threads.0.internal": false, "threads.0.modelled": false, "threads.0.length": 20 } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 2282.515944 } },
    { "note": "The same thread cut into the part: sixteen turns of the basic profile (0.4757 mm^2, its centre 3.724 from the axis: 11.13 mm^3 a turn), less the part of a turn where the groove runs out of the end. Checked to half a percent.",
      "run": "edit.undo" },
    { "run": "model.thread", "with": { "face": "$shank_face", "length": 20, "modelled": true } },
    { "run": "model.threads", "expect": { "threads.0.designation": "M8x1.25", "threads.0.modelled": true } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 2104.39944 }, "within": 0.005 },
    { "run": "model.topology", "expect": { "bodies.0.valid": true, "bodies.0.solids": 1 } },
    { "note": "Mild steel, 7.85 g/cm^3.",
      "run": "document.material", "with": { "name": "Steel, mild" } },
    { "run": "model.mass", "expect": { "mass": 16.5195356, "density": 7.85 }, "within": 0.005 },
    { "note": "Two lengths in a design table. The longer shank keeps its 20 mm of thread: + 320 pi.",
      "run": "table.create", "with": { "columns": ["d1"], "row": "M8x30" } },
    { "run": "table.add_row", "with": { "name": "M8x50", "values": { "d1": 50 } } },
    { "run": "table.activate", "with": { "row": "M8x50" } },
    { "run": "model.regenerate", "expect": { "bodies": 1, "error": null } },
    { "run": "model.threads", "expect": { "threads.0.length": 20 } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 3109.709089 }, "within": 0.005 },
    { "run": "table.activate", "with": { "row": "M8x30" } },
    { "run": "file.save", "with": { "path": "bolt.tenon" } },
    { "run": "render.png", "with": { "path": "bolt.png", "view": "iso", "width": 1024, "height": 768 } },

    { "note": "Handle: a 6 mm round swept along a path that goes up 20, round a 10 mm bend and along 30.",
      "run": "file.new", "with": { "name": "Handle" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "section" },
    { "run": "sketch.circle", "with": { "sketch": "$section.feature", "cx": 0, "cy": 0, "r": 3 } },
    { "run": "sketch.create", "with": { "plane": "xz" }, "as": "path" },
    { "run": "sketch.line", "with": { "sketch": "$path.feature", "x1": 0, "y1": 0, "x2": 0, "y2": 20 }, "as": "up" },
    { "run": "sketch.line", "with": { "sketch": "$path.feature", "x1": 10, "y1": 30, "x2": 40, "y2": 30 }, "as": "along" },
    { "note": "The bend shares its end points with the two lines, so the path is one chain.",
      "run": "sketch.arc", "with": { "sketch": "$path.feature", "cx": 10, "cy": 20, "start": "$along.start", "end": "$up.end" } },
    { "run": "model.sweep", "with": { "sketch": "$section.feature", "path_sketch": "$path.feature" } },
    { "note": "The section's area times the path's length: 9 pi (50 + 5 pi).",
      "run": "model.mass", "expect": { "bodies.0.volume": 1857.848892 }, "within": 0.0001 },
    { "note": "ABS, in a red of its own instead of the material's off-white.",
      "run": "document.material", "with": { "name": "ABS" } },
    { "run": "document.appearance", "with": { "color": "#d04030" }, "expect": { "color": "#d04030" } },
    { "run": "model.mass", "expect": { "mass": 1.932162848 }, "within": 0.0001 },
    { "run": "file.save", "with": { "path": "handle.tenon" } },
    { "run": "render.png", "with": { "path": "handle.png", "view": "iso", "width": 1024, "height": 768 } },

    { "note": "Nozzle. A 50 x 50 x 6 flange whose sides are drafted 5 degrees so it leaves its mould: 50 at the bottom, 50 - 12 tan 5 at the top.",
      "run": "file.new", "with": { "name": "Nozzle" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "flange_sk" },
    { "run": "sketch.rectangle", "with": { "sketch": "$flange_sk.feature", "x1": -25, "y1": -25, "x2": 25, "y2": 25 }, "as": "square" },
    { "run": "model.extrude", "with": { "sketch": "$flange_sk.feature", "distance": 6 }, "as": "flange" },
    { "run": "model.face_ref", "with": { "origin": { "type": "side", "feature": "$flange.feature", "curve": "$square.lines.0" } }, "as": "side0" },
    { "run": "model.face_ref", "with": { "origin": { "type": "side", "feature": "$flange.feature", "curve": "$square.lines.1" } }, "as": "side1" },
    { "run": "model.face_ref", "with": { "origin": { "type": "side", "feature": "$flange.feature", "curve": "$square.lines.2" } }, "as": "side2" },
    { "run": "model.face_ref", "with": { "origin": { "type": "side", "feature": "$flange.feature", "curve": "$square.lines.3" } }, "as": "side3" },
    { "run": "model.draft", "with": { "faces": ["$side0", "$side1", "$side2", "$side3"], "plane": "xy", "angle": 0.08726646259971647, "equations": { "/angle": "5 deg" } } },
    { "note": "A frustum of a square pyramid: 6 / 3 (50^2 + 50 b + b^2), b = 50 - 12 tan 5.",
      "run": "model.mass", "expect": { "bodies.0.volume": 14687.24524 } },

    { "note": "The cone: a loft from a 40 mm circle on the flange to a 16 mm circle 30 higher. 6240 pi.",
      "run": "work.plane", "with": { "base": "xy", "distance": 6 }, "as": "low" },
    { "run": "sketch.create", "with": { "work_plane": "$low.feature" }, "as": "wide" },
    { "run": "sketch.circle", "with": { "sketch": "$wide.feature", "cx": 0, "cy": 0, "r": 20 } },
    { "run": "work.plane", "with": { "base": "xy", "distance": 36 }, "as": "high" },
    { "run": "sketch.create", "with": { "work_plane": "$high.feature" }, "as": "narrow" },
    { "run": "sketch.circle", "with": { "sketch": "$narrow.feature", "cx": 0, "cy": 0, "r": 8 } },
    { "run": "model.loft", "with": { "sections": ["$wide.feature", "$narrow.feature"], "ruled": true } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 34290.7834 } },

    { "note": "The spout: a 16 mm circle extruded 20 with its side leaning in 3 degrees. pi 20 / 3 (64 + 8 r + r^2), r = 8 - 20 tan 3.",
      "run": "sketch.create", "with": { "work_plane": "$high.feature" }, "as": "spout_sk" },
    { "run": "sketch.circle", "with": { "sketch": "$spout_sk.feature", "cx": 0, "cy": 0, "r": 8 } },
    { "run": "model.extrude", "with": { "sketch": "$spout_sk.feature", "distance": 20, "taper": 0.05235987755982988, "equations": { "/taper": "3 deg" } } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 37808.17119 } },

    { "note": "The bore: 8 mm, through everything. - 896 pi.",
      "run": "sketch.create", "with": { "plane": "xy" }, "as": "bore_sk" },
    { "run": "sketch.circle", "with": { "sketch": "$bore_sk.feature", "cx": 0, "cy": 0, "r": 4 } },
    { "run": "model.extrude", "with": { "sketch": "$bore_sk.feature", "through_all": true, "operation": "cut" } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 34993.30417 } },
    { "run": "model.topology", "expect": { "bodies.0.valid": true, "bodies.0.solids": 1 } },

    { "note": "Split along XZ, keeping the far half, to look inside: half the volume.",
      "run": "model.split", "with": { "plane": "xz", "keep": "back" } },
    { "run": "model.regenerate", "expect": { "bodies": 1, "error": null } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 17496.65209 } },
    { "run": "render.png", "with": { "path": "nozzle-section.png", "view": "front", "width": 1024, "height": 768 } },
    { "note": "Back, and split keeping both sides: two solids, half each.",
      "run": "edit.undo" },
    { "run": "model.split", "with": { "plane": "xz" } },
    { "run": "model.regenerate", "expect": { "bodies": 2, "error": null } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 17496.65209, "bodies.1.volume": 17496.65209 } },
    { "note": "Combine joins the halves again, each named by a flange side only it has: one solid of the same volume.",
      "run": "model.combine", "with": { "base": "$side0", "tools": ["$side2"], "operation": "join" } },
    { "run": "model.regenerate", "expect": { "bodies": 1, "error": null } },
    { "run": "model.mass", "expect": { "bodies.0.volume": 34993.30417 } },
    { "note": "Printed in PLA, 1.24 g/cm^3.",
      "run": "document.material", "with": { "name": "PLA" } },
    { "run": "model.mass", "expect": { "mass": 43.39169717, "material": "PLA" } },
    { "run": "file.save", "with": { "path": "nozzle.tenon" } },
    { "run": "export.step", "with": { "path": "nozzle.step" } },
    { "run": "export.stl", "with": { "path": "nozzle.stl" } },
    { "run": "render.png", "with": { "path": "nozzle.png", "view": "iso", "width": 1024, "height": 768 } },

    { "note": "The four in an assembly. Its parts list names each part's material and what one of it weighs; the total weighs each at its own density.",
      "run": "asm.new", "with": { "name": "Fittings" } },
    { "run": "asm.insert", "with": { "path": "nozzle.tenon" } },
    { "run": "asm.insert", "with": { "path": "bolt.tenon", "at": [50, 0, 30] } },
    { "run": "asm.insert", "with": { "path": "spring.tenon", "at": [0, 55, 1] } },
    { "run": "asm.insert", "with": { "path": "handle.tenon", "at": [-70, 0, 0] } },
    { "run": "asm.bom", "expect": {
        "parts": 4,
        "rows.0.name": "Nozzle", "rows.0.material": "PLA", "rows.0.mass": 43.39169717,
        "rows.2.name": "Spring", "rows.2.material": "Stainless steel",
        "rows.3.name": "Handle", "rows.3.material": "ABS" } },
    { "run": "asm.bom", "expect": { "rows.1.name": "Bolt", "rows.1.material": "Steel, mild", "rows.1.mass": 16.5195356, "rows.2.mass": 7.57985618, "rows.3.mass": 1.932162848 }, "within": 0.005 },
    { "note": "39903 mm^3 in all, 69.4 g.",
      "run": "asm.mass", "expect": { "volume": 39903.03452, "mass": 69.4232518 }, "within": 0.005 },
    { "run": "asm.export_bom", "with": { "path": "fittings-bom.csv" }, "expect": { "rows": 4 } },
    { "run": "asm.save", "with": { "path": "fittings.tenonasm" } },
    { "run": "render.png", "with": { "path": "fittings.png", "view": "iso", "width": 1024, "height": 768 } }
  ]
}
