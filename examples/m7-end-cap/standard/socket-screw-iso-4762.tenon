[parameters]
next = 7
user = [
  { name = "d", equation = "8 mm", unit = "mm", comment = "thread diameter" },
  { name = "dk", equation = "13 mm", unit = "mm", comment = "head diameter" },
  { name = "s", equation = "6 mm", unit = "mm", comment = "across the socket's flats" },
  { name = "t", equation = "4 mm", unit = "mm", comment = "socket depth" },
  { name = "l", equation = "30 mm", unit = "mm", comment = "length under the head" },
]
model = [
  { name = "d0", target = { kind = "dimension", sketch = 1, constraint = 2 }, equation = "dk" },
  { name = "d1", target = { kind = "feature", feature = 2, field = "/extent/distance" }, equation = "d" },
  { name = "d2", target = { kind = "feature", feature = 3, field = "/distance" }, equation = "d" },
  { name = "d3", target = { kind = "dimension", sketch = 4, constraint = 15 }, equation = "(s) * 2 / sqrt(3)" },
  { name = "d4", target = { kind = "feature", feature = 5, field = "/extent/distance" }, equation = "t" },
  { name = "d5", target = { kind = "dimension", sketch = 6, constraint = 2 }, equation = "d" },
  { name = "d6", target = { kind = "feature", feature = 7, field = "/extent/distance" }, equation = "l" },
]

