density = 1.24
color = "#4f9fd8"

[parameters]
next = 5
user = []
model = [
  { name = "d0", target = { kind = "feature", feature = 2, field = "/extent/distance" } },
  { name = "d1", target = { kind = "feature", feature = 4, field = "/extent/distance" } },
  { name = "d2", target = { kind = "feature", feature = 6, field = "/extent/distance" } },
  { name = "d3", target = { kind = "feature", feature = 7, field = "/distance" } },
