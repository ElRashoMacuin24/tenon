{
  "name": "M7 demo: a printed end cap on a T-slot bar",
  "description": "The maker's round trip. A cap for the end of a 20 mm T-slot bar is modelled, checked as a printer would take it (which way up, what overhangs, how thin its skirt is, whether it fits the bed) and written out as 3MF and STL. The bar and the screw that holds the cap come from the standard parts library: the bar as a part of its own with its length set, the screw placed straight from the library in the size wanted. In the assembly the screw's thread is found biting into the bar's bore, as it should.",
  "steps": [
    { "note": "What the library holds: fasteners and bearings in their standard sizes, and sections.",
      "run": "library.list", "expect": { "parts.0.part": "hex-screw-iso-4017", "parts.1.standard": "ISO 4762", "parts.4.part": "ball-bearing-iso-15", "parts.9.part": "t-slot" } },

    { "note": "The bar: the generic 20 mm T-slot section as a part of its own, 150 long. A standard part is an ordinary part: its sizes are rows of a design table, its length a parameter.",
      "run": "library.new", "with": { "part": "t-slot", "size": "20x20 slot 6" }, "expect": { "name": "T-Slot Profile", "size": "20x20 slot 6" } },
    { "run": "param.set", "with": { "name": "L", "equation": "150 mm" } },
    { "run": "model.regenerate", "expect": { "bodies": 1, "error": null } },
    { "note": "The section's area times the length: 400 less four slots (6 x 1.8 + 8 x 3 each) and a 4.2 mm bore, x 150.",
      "run": "model.mass", "expect": { "bodies.0.volume": 37041.83646, "material": "Aluminium 6061" }, "within": 0.000001 },
    { "run": "file.save", "with": { "path": "bar.tenon" } },
    { "run": "render.png", "with": { "path": "bar.png", "view": "iso", "width": 1024, "height": 768 } },

    { "note": "The cap: a 24 x 24 x 10 block that sits on the end of the bar.",
      "run": "file.new", "with": { "name": "End Cap" } },
    { "run": "sketch.create", "with": { "plane": "xy" }, "as": "block_sk" },
    { "run": "sketch.rectangle", "with": { "sketch": "$block_sk.feature", "x1": -12, "y1": -12, "x2": 12, "y2": 12 }, "as": "square" },
    { "run": "model.extrude", "with": { "sketch": "$block_sk.feature", "distance": 10 }, "as": "block" },
    { "run": "model.mass", "expect": { "bodies.0.volume": 5760 } },
    { "note": "A skirt 5 deep round the bar, 0.2 clear of it each side: 1.8 thick.",
      "run": "sketch.create", "with": { "plane": "xy" }, "as": "skirt_sk" },
    { "run": "sketch.rectangle", "with": { "sketch": "$skirt_sk.feature", "x1": -12, "y1": -12, "x2": 12, "y2": 12 } },
    { "run": "sketch.rectangle", "with": { "sketch": "$skirt_sk.feature", "x1": -10.2, "y1": -10.2, "x2": 10.2, "y2": 10.2 } },
    { "run": "model.extrude", "with": { "sketch": "$skirt_sk.feature", "distance": 5, "reverse": true }, "as": "skirt" },
    { "note": "+ (24^2 - 20.4^2) x 5",
      "run": "model.mass", "expect": { "bodies.0.volume": 6559.2 } },
    { "note": "A 5.5 mm hole for an M5 screw, and a 10 mm counterbore 6 deep for its head.",
      "run": "sketch.create", "with": { "plane": "xy" }, "as": "hole_sk" },
    { "run": "sketch.circle", "with": { "sketch": "$hole_sk.feature", "cx": 0, "cy": 0, "r": 2.75 }, "as": "hole_c" },
    { "run": "model.extrude", "with": { "sketch": "$hole_sk.feature", "distance": 10, "operation": "cut" }, "as": "hole" },
    { "run": "work.plane", "with": { "base": "xy", "distance": 10 }, "as": "top" },
    { "run": "sketch.create", "with": { "work_plane": "$top.feature" }, "as": "cbore_sk" },
    { "run": "sketch.circle", "with": { "sketch": "$cbore_sk.feature", "cx": 0, "cy": 0, "r": 5 } },
    { "run": "model.extrude", "with": { "sketch": "$cbore_sk.feature", "distance": 6, "reverse": true, "operation": "cut" }, "as": "cbore" },
    { "note": "- 25 pi x 6 - 2.75^2 pi x 4",
      "run": "model.mass", "expect": { "bodies.0.volume": 5992.928 }, "within": 0.000001 },
    { "run": "model.topology", "expect": { "bodies.0.valid": true, "bodies.0.solids": 1 } },
    { "note": "Printed in PLA: 7.4 g.",
      "run": "document.material", "with": { "name": "PLA" } },
    { "run": "model.mass", "expect": { "mass": 7.43123 }, "within": 0.000001 },

    { "note": "How it would print, standing as it is drawn (skirt down): the surface is closed, but the underside of the block hangs over the hollow of the skirt: 20.4^2 less the hole.",
      "run": "print.check", "expect": { "ok": false, "watertight.ok": true, "overhangs.ok": false, "overhangs.area": 392.4, "walls.ok": true, "walls.thinnest": 1.8, "size.height": 15, "up": "z" }, "within": 0.001 },
    { "note": "Turned over, its flat top on the bed, only the floor of the counterbore is over air: 25 pi less the hole, a ring a printer bridges. (The check reads the part as triangles, so a round area is a little under.)",
      "run": "print.check", "with": { "up": "-z" }, "expect": { "watertight.ok": true, "overhangs.area": 54.78, "walls.ok": true }, "within": 0.005 },
    { "note": "A wide nozzle that wants 2 mm walls would not make the 1.8 mm skirt.",
      "run": "print.check", "with": { "up": "-z", "min_wall": 2 }, "expect": { "walls.ok": false, "walls.thinnest": 1.8 }, "within": 0.001 },
    { "note": "It fits the usual 220 x 220 x 250 printer with room to spare.",
      "run": "print.check", "with": { "up": "-z", "bed": [220, 220, 250] }, "expect": { "size.ok": true, "size.x": 24, "size.y": 24, "size.height": 15 } },
    { "run": "file.save", "with": { "path": "end-cap.tenon" } },
    { "note": "For the slicer: 3MF (millimetres, the material's name and colour) and STL. Both hold one closed surface.",
      "run": "export.3mf", "with": { "path": "end-cap.3mf" }, "expect": { "objects": 1, "watertight": true } },
    { "run": "export.stl", "with": { "path": "end-cap.stl" }, "expect": { "watertight": true } },
    { "run": "render.png", "with": { "path": "end-cap.png", "view": "iso", "width": 1024, "height": 768 } },

    { "note": "The assembly: the bar, the cap on its end, and an M5 x 12 socket head cap screw placed from the library (its file is kept in the folder `standard` beside the assembly; every size comes from that one file).",
      "run": "asm.new", "with": { "name": "Capped Bar" } },
    { "run": "asm.insert", "with": { "path": "bar.tenon" }, "as": "bar" },
    { "run": "asm.insert", "with": { "path": "end-cap.tenon", "at": [40, 0, 150] }, "as": "cap" },
    { "run": "asm.insert_standard", "with": { "part": "socket-screw-iso-4762", "size": "M5x12", "path": "standard", "at": [80, 0, 150] }, "as": "screw", "expect": { "row": "M5x12" } },
    { "note": "The cap is inserted on the bar: the rim of its hole, underneath, on the rim of the bar's bore at its end. One relationship puts the two on one axis and face to face.",
      "run": "asm.geom", "with": { "component": "$bar.component", "edge": [{ "type": "cap", "feature": 2, "end": "end" }, { "type": "side", "feature": 7, "curve": 2 }] }, "as": "bore_rim", "expect": { "kind": "circle" } },
    { "run": "asm.geom", "with": { "component": "$cap.component", "edge": [{ "type": "cap", "feature": "$block.feature", "end": "start" }, { "type": "side", "feature": "$hole.feature", "curve": "$hole_c.circle" }] }, "as": "hole_rim", "expect": { "kind": "circle" } },
    { "run": "asm.constrain", "with": { "type": "insert", "a": "$bore_rim", "b": "$hole_rim" } },
    { "note": "The screw is inserted in the cap: the edge under its head on the floor of the counterbore.",
      "run": "asm.geom", "with": { "component": "$cap.component", "edge": [{ "type": "cap", "feature": "$cbore.feature", "end": "end" }, { "type": "side", "feature": "$hole.feature", "curve": "$hole_c.circle" }] }, "as": "seat", "expect": { "kind": "circle" } },
    { "run": "asm.geom", "with": { "component": "$screw.component", "edge": [{ "type": "cap", "feature": 2, "end": "start" }, { "type": "side", "feature": 7, "curve": 2 }] }, "as": "under_head", "expect": { "kind": "circle" } },
    { "run": "asm.constrain", "with": { "type": "insert", "a": "$seat", "b": "$under_head" } },
    { "note": "The cap's XZ plane is kept flush with the bar's, so the cap cannot turn. (A side of the bar would not do: its slot divides it in two.) The screw is left free to turn: one degree of freedom in all.",
      "run": "asm.geom", "with": { "component": "$bar.component", "plane": "xz" }, "as": "bar_plane", "expect": { "kind": "plane" } },
    { "run": "asm.geom", "with": { "component": "$cap.component", "plane": "xz" }, "as": "cap_plane", "expect": { "kind": "plane" } },
    { "run": "asm.constrain", "with": { "type": "flush", "a": "$bar_plane", "b": "$cap_plane" } },
    { "note": "The cap sits on the end of the bar and the screw's head on the floor of the counterbore, 4 above it.",
      "run": "asm.tree", "expect": { "components.1.placement.origin.2": 150, "components.2.placement.origin.2": 154, "components.2.placement.origin.0": 0, "dof": 1 } },
    { "run": "asm.dof", "expect": { "dof": 1, "components.1.dof": 0, "components.2.dof": 1 } },
    { "note": "Interference finds one overlap, and it is the one wanted: the screw's thread in the bar's bore (an M5 thread in a 4.2 mm hole). 8 mm of it: pi (2.5^2 - 2.1^2) x 8.",
      "run": "asm.interference", "expect": { "count": 1, "clashes.0.a": "bar:1", "volume": 46.24424386 }, "within": 0.000001 },
    { "note": "Too little thread for aluminium. The same component as an M5 x 16, from the same file: 12 mm in the bore, and still held where it was.",
      "run": "asm.set_row", "with": { "component": "$screw.component", "row": "M5x16" } },
    { "run": "asm.interference", "expect": { "count": 1, "volume": 69.36636579 }, "within": 0.000001 },
    { "run": "asm.tree", "expect": { "components.2.row": "M5x16", "components.2.placement.origin.2": 154, "dof": 1 } },
    { "note": "The parts list: what each is made of and what one weighs. 111.9 g in all.",
      "run": "asm.bom", "expect": {
        "parts": 3,
        "rows.0.name": "T-Slot Profile", "rows.0.material": "Aluminium 6061", "rows.0.mass": 100.0129584,
        "rows.1.name": "End Cap", "rows.1.material": "PLA", "rows.1.mass": 7.431230626,
        "rows.2.name": "Socket Head Cap Screw, M5x16", "rows.2.material": "Steel, mild", "rows.2.mass": 4.421460186 }, "within": 0.000001 },
    { "run": "asm.mass", "expect": { "volume": 43598.00772, "mass": 111.8656493 }, "within": 0.000001 },
    { "run": "asm.save", "with": { "path": "capped-bar.tenonasm" } },
    { "run": "asm.export_bom", "with": { "path": "capped-bar-bom.csv" }, "expect": { "rows": 3 } },
    { "note": "The whole assembly as one 3MF file: an object for each part, an item for each component where it is, each in its material's colour.",
      "run": "asm.export_3mf", "with": { "path": "capped-bar.3mf" }, "expect": { "objects": 3, "items": 3, "watertight": true } },
    { "run": "render.png", "with": { "path": "capped-bar.png", "view": "iso", "width": 1024, "height": 768 } }
  ]
}
