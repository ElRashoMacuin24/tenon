# Tenon part file, format version 2. The format: docs/file-format.md in the Tenon sources.
format = "tenon"
version = 2
name = "T-Slot Profile"
next_feature = 7

[material]
name = "Aluminium 6061"
density = 2.7
color = "#c3c8ce"

[table]
active = "20x20 slot 6"
columns = ["a", "w", "e", "c", "g", "bore"]
rows = [
  { name = "20x20 slot 6", values = [20.0, 6.0, 1.8, 8.0, 3.0, 4.2] },
  { name = "30x30 slot 8", values = [30.0, 8.0, 2.0, 13.0, 5.5, 6.8] },
  { name = "40x40 slot 8", values = [40.0, 8.0, 4.5, 16.0, 6.5, 6.8] },
]

[parameters]
next = 15
user = [
  { name = "a", equation = "20 mm", unit = "mm", comment = "side" },
  { name = "w", equation = "6 mm", unit = "mm", comment = "slot opening" },
  { name = "e", equation = "1.8 mm", unit = "mm", comment = "lip thickness" },
  { name = "c", equation = "8 mm", unit = "mm", comment = "cavity width" },
  { name = "g", equation = "3 mm", unit = "mm", comment = "cavity depth" },
  { name = "bore", equation = "4.2 mm", unit = "mm", comment = "centre bore" },
  { name = "L", equation = "150 mm", unit = "mm", comment = "length" },
]
model = [
  { name = "d0", target = { kind = "dimension", sketch = 1, constraint = 6 }, equation = "-(a) / 2" },
  { name = "d1", target = { kind = "dimension", sketch = 1, constraint = 7 }, equation = "-(a) / 2" },
  { name = "d2", target = { kind = "dimension", sketch = 1, constraint = 8 }, equation = "a" },
  { name = "d3", target = { kind = "dimension", sketch = 1, constraint = 9 }, equation = "a" },
  { name = "d4", target = { kind = "feature", feature = 2, field = "/extent/distance" }, equation = "L" },
  { name = "d5", target = { kind = "dimension", sketch = 3, constraint = 10 }, equation = "-w / 2" },
  { name = "d6", target = { kind = "dimension", sketch = 3, constraint = 11 }, equation = "a / 2" },
  { name = "d7", target = { kind = "dimension", sketch = 3, constraint = 12 }, equation = "w" },
  { name = "d8", target = { kind = "dimension", sketch = 3, constraint = 13 }, equation = "e" },
  { name = "d9", target = { kind = "dimension", sketch = 3, constraint = 14 }, equation = "c / 2" },
  { name = "d10", target = { kind = "dimension", sketch = 3, constraint = 15 }, equation = "g" },
  { name = "d11", target = { kind = "dimension", sketch = 3, constraint = 16 }, equation = "c" },
  { name = "d12", target = { kind = "feature", feature = 5, field = "/count" } },
  { name = "d13", target = { kind = "feature", feature = 5, field = "/angle" } },
  { name = "d14", target = { kind = "dimension", sketch = 6, constraint = 2 }, equation = "bore" },
]

[[feature]]
id = 1
name = "Sketch1"
suppressed = false
type = "sketch"
plane = { origin = "XY" }
next_entity = 9
next_constraint = 9
entities = [
  { id = 1, type = "point", pos = { x = 0.0, y = 0.0 }, construction = true },
  { id = 2, type = "point", pos = { x = -10.0, y = -10.0 }, construction = false },
  { id = 3, type = "point", pos = { x = 10.0, y = -10.0 }, construction = false },
  { id = 4, type = "point", pos = { x = 10.0, y = 10.0 }, construction = false },
  { id = 5, type = "point", pos = { x = -10.0, y = 10.0 }, construction = false },
  { id = 6, type = "line", start = 2, end = 3, construction = false },
  { id = 7, type = "line", start = 3, end = 4, construction = false },
  { id = 8, type = "line", start = 4, end = 5, construction = false },
  { id = 9, type = "line", start = 5, end = 2, construction = false },
]
constraints = [
  { id = 1, type = "fix", point = 1 },
  { id = 2, type = "horizontal", line = 6 },
  { id = 3, type = "vertical", line = 7 },
  { id = 4, type = "horizontal", line = 8 },
  { id = 5, type = "vertical", line = 9 },
  { id = 6, type = "horizontal_distance", a = 1, b = 2, value = -10.0 },
  { id = 7, type = "vertical_distance", a = 1, b = 2, value = -10.0 },
  { id = 8, type = "length", line = 6, value = 20.0 },
  { id = 9, type = "length", line = 7, value = 20.0 },
]

[[feature]]
id = 2
name = "Extrusion1"
suppressed = false
type = "extrude"
sketch = 1
regions = "default"
extent = { distance = 150.0 }
reverse = false
operation = "join"

